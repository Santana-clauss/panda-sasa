<script>
    // Simple micro-interaction for crop selection
    const cropButtons = document.querySelectorAll('button[class*="min-w-[80px]"]');
    cropButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        cropButtons.forEach(b => {
          b.classList.remove('bg-secondary-container', 'text-on-secondary-container', 'border-primary');
          b.classList.add('bg-white', 'text-on-surface-variant', 'border-outline-variant');
        });
        btn.classList.add('bg-secondary-container', 'text-on-secondary-container', 'border-primary');
        btn.classList.remove('bg-white', 'text-on-surface-variant', 'border-outline-variant');
      });
    });
  </script>
