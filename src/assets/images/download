<script>
    const panel = document.getElementById('detailPanel');
    const countyName = document.getElementById('selectedCounty');

    function openDetails(name) {
      countyName.innerText = name + ' County';
      panel.classList.remove('hidden-state');
    }

    function closeDetails() {
      panel.classList.add('hidden-state');
    }

    // Micro-interactions for map
    document.addEventListener('click', (e) => {
      if (!panel.contains(e.target) && !e.target.closest('button')) {
        closeDetails();
      }
    });
  </script>
